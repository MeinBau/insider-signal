# SEC EDGAR는 자동화된 요청에 실제 연락처가 담긴 User-Agent를 요구합니다 (Fair Access 정책).
# 형식: "앱이름/버전 연락처이메일"
# 반드시 본인의 실제 연락처로 바꿔서 사용하세요. 이 값이 없으면 SEC가 요청을 차단할 수 있습니다.
SEC_EDGAR_CONTACT="insider-signal/0.1 your-email@example.com"

# --- 필터 임계값 (요구사항 1) ---
MIN_TXN_VALUE_USD=100000
MAX_TXN_VALUE_USD=500000

# --- 반복 매수 배제 (요구사항 4) ---
RECURRING_LOOKBACK_DAYS=90
RECURRING_MIN_OCCURRENCES=3

# --- polling 주기 (초) ---
POLL_INTERVAL_SECONDS=300

# --- 로컬 이력 DB 경로 ---
HISTORY_DB_PATH=data/insider_signal.db

# --- 알림 채널 (하나 이상 설정하세요. 아무것도 설정 안 하면 콘솔 로그로만 출력됩니다) ---

# Slack Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Discord Webhook: 채널 설정 > 연동 > 웹후크
DISCORD_WEBHOOK_URL=

# Telegram Bot: @BotFather로 봇 생성 후 토큰 발급, chat id는 본인 채팅방/채널 id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
